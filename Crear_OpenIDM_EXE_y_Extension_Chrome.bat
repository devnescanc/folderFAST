@echo off
chcp 65001 >nul
title Instalador Oficial de Fold FAST v6.0 (Inicio con Windows + Menu Tema/Idioma + Todo Archivo)
echo ============================================================================
echo   FOLD FAST v6.0 - INICIO CON WINDOWS + SEGUNDO PLANO + CAPTURA TOTAL
echo   100%% Nativo para Windows 10/11 - NO requiere instalar Python
echo ============================================================================
echo.

taskkill /F /IM FoldFAST.exe >nul 2>&1
taskkill /F /IM OpenIDM.exe >nul 2>&1
timeout /t 1 /nobreak >nul

set "TARGET_DIR=%USERPROFILE%\Desktop\OpenIDM_Windows"
if not exist "%TARGET_DIR%" mkdir "%TARGET_DIR%"

echo [1/4] Extrayendo archivos de Fold FAST v6.0 y la Extension para Chrome...
set "ZIP_FILE=%TEMP%\foldfast_bundle_v60.zip"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$lines = Get-Content -LiteralPath '%~f0' | Where-Object { $_.StartsWith('::B64:') } | ForEach-Object { $_.Substring(6) }; " ^
  "$b64 = [string]::Join('', $lines); " ^
  "[IO.File]::WriteAllBytes('%ZIP_FILE%', [Convert]::FromBase64String($b64)); " ^
  "Expand-Archive -LiteralPath '%ZIP_FILE%' -DestinationPath '%TARGET_DIR%' -Force"

echo [2/4] Compilando FoldFAST.exe v6.0 con Menu Superior e Inicio con Windows...
set "CSC_PATH=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC_PATH%" set "CSC_PATH=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"

"%CSC_PATH%" /nologo /target:winexe /win32icon:"%TARGET_DIR%\app_icon.ico" /out:"%TARGET_DIR%\FoldFAST.exe" ^
  /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll ^
  /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll ^
  "%TARGET_DIR%\FoldFAST.cs"

copy /Y "%TARGET_DIR%\FoldFAST.exe" "%TARGET_DIR%\OpenIDM.exe" >nul 2>&1

echo [3/4] Creando el icono "Fold FAST" en tu Escritorio y activando Inicio con Windows...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$desktop = [Environment]::GetFolderPath('Desktop'); " ^
  "$lnkPath = Join-Path $desktop 'Fold FAST.lnk'; " ^
  "$ws = New-Object -ComObject WScript.Shell; " ^
  "$sc = $ws.CreateShortcut($lnkPath); " ^
  "$sc.TargetPath = '%TARGET_DIR%\FoldFAST.exe'; " ^
  "$sc.WorkingDirectory = '%TARGET_DIR%'; " ^
  "$sc.IconLocation = '%TARGET_DIR%\app_icon.ico'; " ^
  "$sc.Description = 'Fold FAST - Open Source Download & Media Accelerator'; " ^
  "$sc.Save()"

reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v "FoldFAST" /t REG_SZ /d ""%TARGET_DIR%\FoldFAST.exe" --minimized" /f >nul 2>&1

if exist "%TARGET_DIR%\FoldFAST.exe" (
    echo.
    echo [4/4] ¡FOLD FAST v6.0 INSTALADO Y ACTIVO!
    echo   1. Iniciara automaticamente con Windows y permanecera activo junto al reloj.
    echo   2. Tienes la barra de menu arriba a la izquierda ^(Archivo / Tema / Idioma^).
    echo   3. En Chrome ^(chrome://extensions^), pulsa el boton de recargar ^(↻^) en la extension.
    echo.
    start "" "%TARGET_DIR%\FoldFAST.exe"
) else (
    echo Hubo un error al compilar FoldFAST.exe.
    pause
)
exit /b 0

